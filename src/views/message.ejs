<!DOCTYPE html>
<html lang="en">
<head>
<%- include('head', locals); %>
</head>
<%# Background color is defined in body attributes for ancient browsers, like Netscape 4.x %>
<body bgcolor="#FFFFFF" text="#2c3e50" link="#0d6efd" vlink="#0d6efd" alink="#0a58ca">
    <div class="container">
        <div class="panel">
            <h3 class="panel-title">Message</h3>
            <div class="body">
                <p><%= locals.message %></p>
                <% if(locals.forceMobileMode){ %>
                    <p style="text-align: center; font-weight: bold;"><a href="/?mobile=true">OK</a></p>
                <% } else{ %>
                    <p style="text-align: center; font-weight: bold;"><a href="/">OK</a></p>
                <% } %>
            </div>
        </div>
    </div>
    <p class="footer">
        <% if(locals.forceMobileMode){ %>
            <a href="/">Disable mobile mode</a> | <a href="privacy/">Privacy policy</a>
        <% } else{ %>
            <a href="/?mobile=true">Mobile mode</a> | <a href="privacy/">Privacy policy</a>
        <% } %>
        <br /><br />
        <%= locals.userAgent %>
    </p>
</body>
</html>